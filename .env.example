# Gemini API Key (Required if using Gemini provider)
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Required if using OpenAI provider)
# Get your key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# LM Studio API Key (Optional, required if using LM Studio provider)
# Get your key from your LM Studio instance if you have set up API key authentication
LM_STUDIO_API_KEY=your_lm_studio_api_key_here

#  Ollama API Key (Optional, required if using Ollama provider)
# Get your key from your Ollama instance if you have set up API key authentication
OLLAMA_API_KEY=your_ollama_api_key_here

# Search provider API keys
# Google Custom Search API credentials
GOOGLE_SEARCH_API_KEY=your_google_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# Bing Search API key
BING_SEARCH_API_KEY=your_bing_search_api_key_here

# Brave Search API key
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# DuckDuckGo does not require a key; it uses HTML scraping fallback.

# Database configuration (default: sqlite)
DB_DRIVER=sqlite
DB_SQLITE_FILE=database/database.sqlite

# MySQL / MariaDB sample
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketing_ai
# DB_USERNAME=root
# DB_PASSWORD=secret
# DB_CHARSET=utf8mb4

# PostgreSQL sample
# DB_DRIVER=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=marketing_ai
# DB_USERNAME=postgres
# DB_PASSWORD=secret
# DB_SSLMODE=prefer

# SQL Server sample
# DB_DRIVER=sqlsrv
# DB_HOST=127.0.0.1
# DB_PORT=1433
# DB_DATABASE=marketing_ai
# DB_USERNAME=sa
# DB_PASSWORD=secret

# Oracle sample
# DB_DRIVER=oracle
# DB_HOST=127.0.0.1
# DB_PORT=1521
# DB_DATABASE=ORCLCDB
# DB_SERVICE_NAME=ORCLCDB
# DB_USERNAME=system
# DB_PASSWORD=secret

# Local LLM Endpoints (Optional, defaults will be used if empty)
# LM_STUDIO_URL=http://localhost:1234/v1
# OLLAMA_URL=http://localhost:11434/v1
